<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
	version="6.0">
	<display-name>Secure Jakarta RESTful File Handler</display-name>
	<!-- Initialization parameter for file storage location -->
	<context-param>
		<param-name>destination_dir</param-name>
		<param-value>files</param-value>
	</context-param>
	<!-- Register the ServletContextListener -->
	<listener>
		<listener-class>util.ConfigListener</listener-class>
	</listener>
	<!-- Global HTTPS enforcement for /rest/* -->
	<security-constraint>
		<web-resource-collection>
			<web-resource-name>File Handler Service</web-resource-name>
			<url-pattern>/rest/*</url-pattern>
		</web-resource-collection>
		<user-data-constraint>
			<transport-guarantee>CONFIDENTIAL</transport-guarantee>
		</user-data-constraint>
	</security-constraint>
	<!-- Allow unauthenticated access to file listing -->
	<security-constraint>
		<web-resource-collection>
			<web-resource-name>File List Service</web-resource-name>
			<url-pattern>/rest/file/service/files</url-pattern>
		</web-resource-collection>
	</security-constraint>
	<!-- Restrict upload/download services to authenticated users with role 
		'user' -->
	<security-constraint>
		<web-resource-collection>
			<web-resource-name>Upload and Download Services</web-resource-name>
			<url-pattern>/rest/file/service/download/*</url-pattern>
			<url-pattern>/rest/file/service/upload/*</url-pattern>
		</web-resource-collection>
		<auth-constraint>
			<role-name>user</role-name>
		</auth-constraint>
	</security-constraint>
	<!-- Basic authentication configuration -->
	<login-config>
		<auth-method>BASIC</auth-method>
		<realm-name>Jakarta File Service Realm</realm-name>
	</login-config>
	<!-- Define security roles used in the application -->
	<security-role>
		<role-name>user</role-name>
	</security-role>
	<!-- <security-role> <role-name>admin</role-name> </security-role> -->
	<!-- Jersey Servlet configuration -->
	<servlet>
		<servlet-name>jersey-servlet</servlet-name>
		<servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>
		<!-- Package where REST services are located -->
		<init-param>
			<param-name>jersey.config.server.provider.packages</param-name>
			<param-value>rest.file.service</param-value>
		</init-param>
		<!-- Enable file upload support (multipart) -->
		<init-param>
			<param-name>jersey.config.server.provider.classnames</param-name>
			<param-value>org.glassfish.jersey.media.multipart.MultiPartFeature</param-value>
		</init-param>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet-mapping>
		<servlet-name>jersey-servlet</servlet-name>
		<url-pattern>/rest/*</url-pattern>
	</servlet-mapping>
</web-app>